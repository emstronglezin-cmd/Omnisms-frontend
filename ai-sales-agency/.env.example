# Obtenu après: node gmail/auth.js
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=votre@gmail.com
GMAIL_SENDER_NAME=AI Sales Agency

# ─── OPENAI (optionnel — templates actifs sans OpenAI) ────────
OPENAI_API_KEY=sk-...votre_cle_openai
