# ─── GOOGLE MAPS (optionnel — simulation active sans Maps) ────
GOOGLE_MAPS_API_KEY=

# ─── APPLICATION ─────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# Mode test: true = emails simulés, false = vrais emails envoyés
TEST_MODE=true

# ─── LIMITES EMAIL (protection anti-spam) ────────────────────
MAX_EMAILS_PER_DAY=10
MIN_DELAY_DAYS=7
MAX_RELANCES=1
MIN_SCORE=50
MAX_LEADS_PER_DAY=50
