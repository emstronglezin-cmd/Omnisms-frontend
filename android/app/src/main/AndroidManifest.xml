<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Permissions pour l'accès réseau -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Permission microphone pour les messages vocaux -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Permission carnet d'adresses : import direct des contacts du téléphone
         (flutter_contacts) → POST /api/contacts/sync -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Permission notifications système (Android 13+ / API 33+) -->
    <!-- Demandée à l'exécution depuis NotificationsSettingsScreen via permission_handler -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="omni_smsnew"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="false"
        android:allowBackup="false"
        android:fullBackupContent="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- ─── Deep links OmniSMS (retour OAuth Google) ────────────────
                 omnisms://auth/google/callback           → connexion Google
                 omnisms://auth/google/contacts/callback  → autorisation contacts
                 Reçus par le plugin app_links (lib/services/google_oauth_flow.dart).
                 ─────────────────────────────────────────────────────────── -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="omnisms" android:host="auth"/>
            </intent-filter>

            <!-- ─── Android App Links (retour OAuth en HTTPS) ───────────────
                 Le backend redirige le flux « app » vers GOOGLE_FLUTTER_REDIRECT_URI,
                 qui pointe aujourd'hui vers la PWA :
                     https://omnisms-frontend-drab.vercel.app/?code=…
                 Sans ce filtre, ce lien ouvre Chrome (et donc la PWA) au lieu
                 de revenir dans l'APK.

                 Pour que l'ouverture soit DIRECTE (sans dialogue « Ouvrir
                 avec »), le domaine doit publier :
                     https://<host>/.well-known/assetlinks.json
                 avec l'empreinte SHA-256 du certificat de signature.
                 Fichier fourni : android/assetlinks.json (à déployer).

                 Chemins revendiqués, volontairement limités :
                   • /                       → retour « app » (racine de la PWA)
                   • /auth/google/…          → retours login et contacts
                 ─────────────────────────────────────────────────────────── -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="https"
                    android:host="omnisms-frontend-drab.vercel.app"
                    android:path="/"/>
                <data
                    android:scheme="https"
                    android:host="omnisms-frontend-drab.vercel.app"
                    android:pathPrefix="/auth/google/"/>
                <data
                    android:scheme="https"
                    android:host="omnisms.vercel.app"
                    android:path="/"/>
                <data
                    android:scheme="https"
                    android:host="omnisms.vercel.app"
                    android:pathPrefix="/auth/google/"/>
            </intent-filter>

            <!-- Le deep linking Flutter par défaut doit être désactivé à partir
                 de Flutter 3.24 pour que app_links reçoive les liens. -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="false"/>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- ─── Start.io SDK Configuration ────────────────────────────────
             Remplacer YOUR_START_IO_APP_ID par l'App ID de votre dashboard Start.io
             https://portal.start.io/
             ─────────────────────────────────────────────────────────────── -->
        <meta-data
            android:name="com.startapp.sdk.APPLICATION_ID"
            android:value="YOUR_START_IO_APP_ID" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher : ouvrir le navigateur système pour l'OAuth Google -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
