# ─────────────────────────────────────────────────────────────────────────────
# Podfile — OmniSMS iOS
#
# Ce fichier était ABSENT du dépôt : sans lui, `pod install` est impossible et
# aucun build iOS ne peut aboutir. Il suit le gabarit officiel Flutter 3.47.7.
#
# Cible minimale : iOS 15.0 — imposée par le moteur, pas par un choix.
#   Flutter 3.47.7 génère, à l'exécution de `pod install`, un podspec
#   « Flutter » qui déclare s.ios.deployment_target = '15.0'
#   (flutter_tools/bin/podhelper.rb). Avec '13.0' dans ce fichier, CocoaPods
#   échoue : « Specs satisfying the `Flutter` dependency were found, but they
#   required a higher minimum deployment target ».
#   Conséquence assumée : iOS 13 et 14 ne sont plus pris en charge. En
#   pratique seuls les iPhone 5s, 6/6 Plus et l'iPod touch 6e génération,
#   bloqués à iOS 12, sortent du périmètre ; les iPhone 6s et suivants
#   peuvent monter vers iOS 15.
#
# Aucune clé, aucun certificat, aucun mot de passe Apple et aucun secret
# backend n'est écrit ici : la signature reste « Automatic » et l'équipe de
# développement est renseignée dans Xcode, sur le Mac de build.
# ─────────────────────────────────────────────────────────────────────────────
platform :ios, '15.0'

# Les statistiques CocoaPods allongent sensiblement les builds Flutter.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run \"flutter pub get\""
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # Uniformise la cible iOS : sans cela, certains pods (StartAppSDK, plugins
    # sans version explicite) héritent d'une cible plus ancienne et le build
    # échoue avec « The pod X requires a higher minimum deployment target ».
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      # Flutter ne prend pas en charge Bitcode (supprimé depuis Xcode 14).
      config.build_settings['ENABLE_BITCODE'] = 'NO'
    end
  end
end
